{
  "name": "quark-sync",
  "version": "1.7.0",
  "description": "自动从夸克网盘分享链接中提取最近两天更新的文件并转存到自己的网盘",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "sync": "node src/index.js",
    "download": "node src/index.js download",
    "download-force": "node src/index.js download --force-download",
    "alist": "node src/index.js alist",
    "alist-force": "node src/index.js alist --force-download",
    "schedule": "node src/index.js schedule",
    "web": "node src/index.js web",
    "sync-dry": "node src/index.js --dry-run",
    "test": "node --test",
    "docker:build": "node scripts/docker-build.mjs",
    "docker:build:local": "node scripts/docker-build.mjs --no-push --platform linux/amd64"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "node-cron": "^4.2.1"
  }
}
