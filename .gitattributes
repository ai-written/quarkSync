# 带 shebang 的脚本必须保持 LF。
# 本仓库若在 Windows 上以 core.autocrlf=true 检出，脚本会被转成 CRLF：
#  - docker-entrypoint.sh：Docker COPY 原样保留字节，shebang 变成 "#!/bin/sh\r"，
#    Alpine 下 ENTRYPOINT 直接 exec 失败（报 no such file or directory）
#  - scripts/*.mjs：虽然 npm script 用 `node <file>` 调用（shebang 不参与），
#    但在 Linux 上直接 ./scripts/docker-build.mjs 执行时同样会失败
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
scripts/*.mjs text eol=lf
# GitHub Actions 工作流同样必须保持 LF：
# run: 块里的多行 shell 脚本若带 \r，bash 会把 "pipefail\r" 当成非法参数，
# 整个步骤直接失败（与上面 shebang 那类问题同源）
.github/workflows/*.yml text eol=lf
